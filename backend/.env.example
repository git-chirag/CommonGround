# Copy to .env (never commit .env). No secrets are needed for kiro_cli:
# it uses your existing local `kiro-cli` login.

# Provider: kiro_cli (local dev only). "gemini" is reserved, not implemented yet.
LLM_PROVIDER=kiro_cli

# Path to the CLI if it is not on PATH (leave blank to use "kiro-cli").
KIRO_CLI_PATH=

# The CLI saves every call (including family notes in the prompt) under ~/.kiro/sessions.
# true = delete that session in the background after each call (recommended).
KIRO_CLI_DELETE_SESSIONS=true

# Per-request timeout in seconds.
LLM_TIMEOUT_SECONDS=90

# Optional model id passed to `kiro-cli chat --model`. Leave blank for the CLI default.
# List valid ids with: kiro-cli chat --list-models
LLM_MODEL=

# Browser origins allowed to call this API (comma-separated, explicit; "*" is refused).
# Local frontend default shown. No credentials/cookies are allowed cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Safety limits.
LLM_MAX_PROMPT_CHARS=24000
LLM_MAX_CONCURRENT=2
